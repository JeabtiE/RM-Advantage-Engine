# Copy this file to .env and fill in your real key.

# Anthropic API key — SERVER-ONLY. Read by api/claude-agent.js (Vercel function /
# Vite dev plugin). NEVER prefix it with VITE_: any VITE_* variable is bundled
# into browser code. The dev server refuses to start if VITE_ANTHROPIC_API_KEY
# is set.
ANTHROPIC_API_KEY=

# Kill switch for the live agent endpoint. Only the exact value "true" enables
# Anthropic calls; anything else (including unset) makes /api/claude-agent return
# 503 live_mode_disabled. Set it locally to use live analysis; leave it unset on
# the public deployment (the cached demo scenarios need no API calls).
# LIVE_AGENT_ENABLED=true
